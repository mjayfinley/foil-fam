{%- comment -%}
  "Join the fam" signup. Uses Shopify's customer form, so emails land in Customers
  (subscribed to email marketing, tagged "newsletter").
{%- endcomment -%}
<section class="ff signup center" id="contact">
  <div class="wrap">
    {%- if section.settings.script != blank -%}
      <span class="script"><svg class="sparkle" viewBox="0 0 24 24" aria-hidden="true"><use href="#ff-sparkle"/></svg> {{ section.settings.script | escape }} <svg class="sparkle flip" viewBox="0 0 24 24" aria-hidden="true"><use href="#ff-sparkle"/></svg></span>
    {%- endif -%}
    <h2>{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif -%}
    {%- form 'customer', id: 'ff-signup-form', class: 'signup-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="signup-msg" role="status">{{ section.settings.success | escape }}</p>
      {%- else -%}
        <input type="email" name="contact[email]" placeholder="Your email address" aria-label="Email address" autocomplete="email" required value="{{ form.email }}">
        <button class="btn" type="submit">{{ section.settings.button | escape }}</button>
        {%- if form.errors -%}
          <p class="signup-msg" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Foil Fam signup",
  "settings": [
    { "type": "text", "id": "script", "label": "Label", "default": "join the fam" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Be the first to know" },
    { "type": "text", "id": "text", "label": "Sub line", "default": "early access, print reveals, specials & updates" },
    { "type": "text", "id": "button", "label": "Button", "default": "Notify Me" },
    { "type": "text", "id": "success", "label": "Thank-you message", "default": "You’re in the fam! Watch your inbox for the drop." }
  ],
  "presets": [{ "name": "Foil Fam signup" }]
}
{% endschema %}
