{%- comment -%} "How to get your foils": one card per block (Shipping, Local Salon Pickup, Weekly Local Delivery). {%- endcomment -%}
<section class="ff howto">
  <div class="wrap">
    <div class="section-head center">
      {%- if section.settings.script != blank %}<span class="script">{{ section.settings.script | escape }}</span>{% endif %}
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="ways">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="way" {{ block.shopify_attributes }}>
          <div class="icon">
            {%- case b.icon -%}
              {%- when 'store' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M4 10v10h16V10"/><path d="M2.5 10 5 4h14l2.5 6a3 3 0 0 1-6 0 3 3 0 0 1-6.5 0 3 3 0 0 1-6.5 0Z"/><path d="M10 20v-5h4v5"/></svg>
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M2 6h11v10H2zM13 9h4l4 4v3h-8"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5v-9Z"/><path d="m3 7.5 9 4.5 9-4.5M12 12v9"/></svg>
            {%- endcase -%}
          </div>
          <h3>{{ b.title | escape }}</h3>
          {%- if b.text != blank %}<p>{{ b.text | escape }}</p>{% endif -%}
          {%- if b.address != blank %}<address class="way-details">{{ b.address | escape | newline_to_br }}</address>{% endif -%}
          {%- if b.phones != blank -%}
            <ul class="phones">
              {%- assign lines = b.phones | newline_to_br | split: '<br />' -%}
              {%- for line in lines -%}
                {%- assign label = line | strip -%}
                {%- if label == blank %}{% continue %}{% endif -%}
                {%- assign number = label | split: '•' | last | remove: '(' | remove: ')' | remove: '-' | remove: ' ' | remove: '.' -%}
                <li><a href="tel:+1{{ number }}">{{ label | escape }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if b.note != blank %}<p class="way-note">{{ b.note | escape }}</p>{% endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Foil Fam how to get",
  "settings": [
    { "type": "text", "id": "script", "label": "Handwritten label", "default": "made easy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How to get your foils" }
  ],
  "blocks": [
    {
      "type": "way",
      "name": "Card",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "box", "options": [
          { "value": "box", "label": "Box (shipping)" },
          { "value": "store", "label": "Storefront (pickup)" },
          { "value": "truck", "label": "Truck (delivery)" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Shipping" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "textarea", "id": "address", "label": "Address", "info": "Optional. Each line shows on its own line." },
        { "type": "textarea", "id": "phones", "label": "Phone numbers", "info": "Optional. One per line, like: Hali • (832) 296-3751. Tapping calls the number." },
        { "type": "text", "id": "note", "label": "Note pill", "info": "Optional, e.g. a delivery fee." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{
    "name": "Foil Fam how to get",
    "blocks": [
      { "type": "way", "settings": { "icon": "box", "title": "Shipping", "text": "Wrapped with love & shipped right to your door." } },
      { "type": "way", "settings": { "icon": "store", "title": "Local Salon Pickup", "text": "Contact us first!", "address": "7111 FM 2920, Suite 207\nSpring, TX 77379", "phones": "Hali • (832) 296-3751\nLauryn • (832) 585-6652" } },
      { "type": "way", "settings": { "icon": "truck", "title": "Weekly Local Delivery", "text": "Tuesdays to Spring, Tomball & The Woodlands.", "note": "$5 delivery fee on orders under $50" } }
    ]
  }]
}
{% endschema %}
