<div class="ff announce">
  {%- if section.settings.script != blank -%}
    <em><svg class="sparkle" viewBox="0 0 24 24" aria-hidden="true"><use href="#ff-sparkle"/></svg> {{ section.settings.script | escape }} <svg class="sparkle flip" viewBox="0 0 24 24" aria-hidden="true"><use href="#ff-sparkle"/></svg></em>
  {%- endif -%}
  {%- if section.settings.text != blank -%}
    <span>
      {%- if section.settings.link != blank %}<a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>{% else %}{{ section.settings.text | escape }}{% endif -%}
    </span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Foil Fam announcement",
  "class": "ff-section-announce",
  "settings": [
    { "type": "text", "id": "script", "label": "Handwritten line", "default": "the wait is almost over" },
    { "type": "text", "id": "text", "label": "Main line", "default": "Our first drop arrives New Year’s Day!" },
    { "type": "url", "id": "link", "label": "Link (optional)" }
  ],
  "presets": [{ "name": "Foil Fam announcement" }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
